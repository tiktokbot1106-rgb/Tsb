local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local Player = Players.LocalPlayer
local Character = Player.Character or Player.CharacterAdded:Wait()
local Root = Character:WaitForChild("HumanoidRootPart")

local ToolActivate = ReplicatedStorage
    .Shared.Packages.Knit.Services.ToolService.RF.ToolActivated

--================ CONFIG =================

getgenv().Config = {
    Enabled = false,
    TweenSpeed = 8, -- studs por segundo (REAL)
    SafeHeight = 6, -- flutuar acima da pedra
    MinSwingDelay = 0.6,
    MaxSwingDelay = 0.9,

    RockFolders = {
        "Island1CaveStart",
        "Island1CaveMid",
        "Island1CaveDeep"
    }
}

--================ STATS =================

local mined = 0
local activeTime = 0
local CurrentTarget = nil
local currentTween = nil

--================ GUI =================

local gui = Instance.new("ScreenGui", game.CoreGui)
gui.Name = "AutoMineGUI"

local frame = Instance.new("Frame", gui)
frame.Size = UDim2.fromScale(0.28,0.42)
frame.Position = UDim2.fromScale(0.36,0.28)
frame.BackgroundColor3 = Color3.fromRGB(20,20,20)
Instance.new("UICorner", frame)

